# Copy to .env and fill in real values. Never commit real credentials.

# Lovable Cloud / Supabase (client-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode) — secret keys must never be used in frontend code
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# Maps / tracking (optional, for future GPS integration)
VITE_MAPBOX_TOKEN=pk.xxx
VITE_GOOGLE_MAPS_API_KEY=xxx
